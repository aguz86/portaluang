# ==============================================================================
# PORTAL UANG — ENVIRONMENT VARIABLES CONFIGURATION
# All private keys, secret keys, API tokens, merchant credentials, and SMTP
# passwords MUST live here on the server. Never store them in the database or UI.
# ==============================================================================

# --- Core Database & App URL ---
# PostgreSQL Connection String (Supabase Transaction Pooler IPv4 Port 6543)
DATABASE_URL=""
# Public URL where this app is hosted (used for Duitku callbacks, Telegram webhooks, and email links)
APP_URL="MY_APP_URL"

# --- Admin Security & Encryption ---
ADMIN_EMAIL="admin@portaluang.id"
ADMIN_PASSWORD=""
ADMIN_TOTP_SECRET=""
ADMIN_SESSION_SECRET=""
# Comma-separated admin IPs allowed to login (e.g. "114.79.20.150,203.0.113.5"). Leave empty or "*" to allow any IP.
ADMIN_IP_WHITELIST=""
# 32+ char secret for AES-256-GCM encryption
ENCRYPTION_KEY=""

# --- AI Advisor Engine ---
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-chat"

# --- Duitku Payment Gateway ---
DUITKU_ENV="sandbox"
DUITKU_SANDBOX_MERCHANT_CODE=""
DUITKU_SANDBOX_API_KEY=""
DUITKU_PRODUCTION_MERCHANT_CODE=""
DUITKU_PRODUCTION_API_KEY=""

# --- Telegram Bot Integration ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Optional: override webhook URL explicitly (defaults to "${APP_URL}/api/telegram/webhook")
TELEGRAM_WEBHOOK_URL=""

# --- Meta Marketing (Pixel & Conversions API) ---
META_PIXEL_ID=""
META_CAPI_TOKEN=""

# --- Self-Hosted VPS SMTP (Rp 0 selamanya: Postfix / Stalwart / Mailcow / Postal) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_ALLOW_SELF_SIGNED="false"
SMTP_NO_AUTH="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Portal Uang <noreply@domainanda.com>"

# --- Optional Self-Hosted FreeResend HTTP API (Rp 0 on your own VPS) ---
RESEND_BASE_URL=""
RESEND_API_KEY=""

# --- Optional Default Developer Email for Error Monitor (customizable in Admin UI) ---
DEVELOPER_EMAIL=""

# --- Headless Payload CMS Integration (Blog, Tentang Kami, & Panduan Panjang) ---
PAYLOAD_CMS_URL=""
PAYLOAD_CMS_API_KEY=""
PAYLOAD_WEBHOOK_SECRET=""

# --- Public Client-Side IDs ---
# Google Drive OAuth Client ID for user-side Backup & Restore
VITE_GDRIVE_CLIENT_ID="YOUR_GDRIVE_CLIENT_ID_HERE"
